PORT=3000
APP_MODE=demo
LOCAL_AUTH_TOKEN=
ENABLE_WEB_TERMINAL=false
ALLOW_PRIVATE_NETWORK_TARGETS=false
DATA_DIR=data
PRIVATE_DIR=private
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Dashboard session auth (used when APP_MODE=local)
# DASHBOARD_SESSION_SECRET=         # Required when APP_MODE=local. Pepper for session token hashing.
# DASHBOARD_SESSION_TTL_SECONDS=86400  # Session TTL in seconds (default: 24h)
# DASHBOARD_PUBLIC_ORIGIN=          # Optional: expected Origin header for CSRF protection
# DASHBOARD_COOKIE_SECURE=false     # Set to true when serving over HTTPS
# DASHBOARD_COOKIE_SAME_SITE=lax    # lax | strict | none
