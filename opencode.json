{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    }
  },
  "agent": {
    "designer": {
      "permission": {
        "skill": {
          "banner-design": "allow",
          "brand": "allow",
          "design": "allow",
          "design-system": "allow",
          "slides": "allow",
          "ui-styling": "allow",
          "ui-ux-pro-max": "allow"
        }
      }
    }
  }
}
